POSTGRES_DB=lecture
POSTGRES_USER=lecture_user
POSTGRES_PASSWORD=lecture_pass
DJANGO_SECRET_KEY=django-insecure-change-me

# ローカルHTTPではfalse。HTTPSで公開する場合は両方をtrueにしてください。
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_HTTPONLY=false

# 別のアプリや2025年版と同時に起動する場合はホスト側のポートを変更してください。
POSTGRES_HOST_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
